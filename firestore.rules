rules_version = '2';

// Todo o acesso ao banco passa exclusivamente pelo Firebase Admin SDK,
// usado somente dentro das Server Actions do Next.js (nunca no client).
// Por isso, o client SDK do Firebase nunca é usado neste projeto e
// TODO acesso direto (que ignoraria nossa autenticação própria) é bloqueado aqui.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
